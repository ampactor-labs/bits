{
  "name": "BITS",
  "short_name": "BITS",
  "description": "A puppet show instrument. Record the bit, cast puppets, perform in passes.",
  "id": "/bits/",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "background_color": "#141210",
  "theme_color": "#141210",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "inbox",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "bit",
          "accept": [
            "application/json",
            ".json",
            "text/plain"
          ]
        }
      ]
    }
  }
}
